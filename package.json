    "mugshots": "node scripts/mugshots.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pihme/helferlein.git"
  },
  "homepage": "https://pihme.github.io/helferlein/",
  "bugs": {
    "url": "https://github.com/pihme/helferlein/issues"
  },
  "keywords": [
    "avatar",
    "three.js",
    "webgl",
    "3d",
    "animation",
    "assistant"
  ]

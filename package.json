  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/helferlein.js"
    },
    "./min": "./dist/helferlein.min.js",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist/helferlein.js",
    "dist/helferlein.min.js",
    "types/index.d.ts",
